# Supabase Configuration
# Získáš v Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Telegram Bot Configuration
# Získáš od @BotFather na Telegramu
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Bezpečnost: Povolení uživatelé pro nahrávání fotek (čárkou oddělená ID)
# Zjistíš např. zasláním /start botovi nebo přes @userinfobot
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321
